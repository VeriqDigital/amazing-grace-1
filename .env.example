NEXT_PUBLIC_SITE_URL=https://www.amazinggraceantiques.com

# Public editorial content only. Leave both blank to run without a connected CMS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional viewer token if using a private editorial dataset. Server-only.
SANITY_API_READ_TOKEN=

# Contact form delivery through the Resend Email API.
# Example: Amazing Grace Antiques <website@your-verified-domain.com>
RESEND_API_KEY=
CONTACT_FROM_EMAIL= 
CONTACT_TO_EMAIL=sherri@amazinggraceantiques.com

# Private item submissions, photos, notification queue, and shared rate limits.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Independent random secrets, at least 32 characters each. Server-only.
FORM_RATE_LIMIT_SECRET=
CRON_SECRET=
# Non-Vercel deployments only: header your trusted reverse proxy OVERWRITES.
# Do not blindly trust a client-supplied X-Forwarded-For header.
TRUSTED_IP_HEADER=
